/* Emoticon selector panel */
#emoticonSelector {
    background: $panel_bg;
    border: 2px solid $panel_border;
    border-radius: 10px;
}

#emoticonNav,
#emoticonNav QWidget {
    background: $panel_bg;
    border: none;
    border-bottom: 1px solid $panel_border;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

#emoticonContent,
#emoticonContent QWidget {
    background: $panel_bg;
    border: none;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

QScrollArea#emoticonScroll {
    background: transparent;
    border: none;
}

QStackedWidget#emoticonStack {
    background: transparent;
    border: none;
}

QLabel#emoticonPlaceholder {
    color: #888;
    padding: 20px;
}

/* Group tabs */
#emoticonNav QPushButton {
    background: transparent;
    border: 2px solid transparent;
    border-radius: 8px;
}

#emoticonNav QPushButton:hover {
    background: $btn_hover_bg;
    border: 2px solid $btn_hover_border;
}

#emoticonNav QPushButton[active="true"],
#emoticonNav QPushButton[active="true"]:hover {
    background: $btn_active_bg;
    border: 2px solid $btn_active_border;
}

/* Emoticon buttons; "highlighted" is the keyboard cursor */
QPushButton#emoticonButton {
    background: transparent;
    border: 2px solid transparent;
    border-radius: 8px;
    padding: 2px;
}

QPushButton#emoticonButton:hover {
    background: $btn_hover_bg;
    border: 2px solid $btn_hover_border;
}

QPushButton#emoticonButton[highlighted="true"],
QPushButton#emoticonButton[highlighted="true"]:hover {
    background: $btn_active_bg;
    border: 2px solid $btn_active_border;
}
